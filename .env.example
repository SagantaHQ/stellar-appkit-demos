# WalletConnect project ID — get one at https://cloud.walletconnect.com (free)
# Required for the /demos/walletconnect demo to connect Hana, Lobstr, and Hot Wallet.
# When unset, the WalletConnect connector is silently omitted and the demo
# shows a setup guide instead of the QR code.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Google Analytics ID (optional) — G-XXXXXXXXXX format
# NEXT_PUBLIC_GA_ID=
