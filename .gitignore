# dependencies
/node_modules

# lockfiles — generated by the package manager, not committed.
# Cloudflare CI regenerates them via `npm install` (not `npm ci`).
# This avoids the "lock file out of sync" build failure that happens
# when package.json is bumped but the lockfile isn't.
package-lock.json
bun.lockb
bun.lock
yarn.lock
pnpm-lock.yaml

# next.js
/.next/
/out/

# production
/build

# open-next (cloudflare build output)
/.open-next/
/.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts
