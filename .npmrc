# Cloudflare's build image uses npm v11+, which by default blocks install-time
# lifecycle scripts (esbuild, sharp, workerd all need them to function).
# Approve them explicitly so `npm ci` succeeds during the Cloudflare build.
# See https://docs.npmjs.com/cli/v11/commands/npm-install#allow-scripts

# Run install scripts for these packages (the ones we depend on that need them).
# Listed by package name — npm v11 ignores versions in this field.
allow-scripts[]=esbuild
allow-scripts[]=sharp
allow-scripts[]=workerd
